{
    "compilerOptions": {
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "target": "es2019",
        "module": "esnext",
        "isolatedModules": true,
        "noEmit": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "strict": true,
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "incremental": false,
        "skipLibCheck": true,
        "baseUrl": "src",
        "outDir": "./dist",
        "moduleResolution": "bundler",

        // What @types/jest used to declare: the suite runs with vitest's
        // globals rather than importing describe/expect/vi in every file.
        "types": [
            "vitest/globals"
        ],
    },
    "include": [
        "."
    ],
    "exclude": [
        ".git",
        "**/node_modules/*",
        "dist",
        "pack"
    ]
}
