// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pages/welcome > Welcome Page shows Explore Page 1`] = `
<div>
  <div
    data-testid="location"
  >
    /welcome
  </div>
  <div
    class="WelcomePage"
  >
    <div
      class="wrapper"
    >
      <h1
        class="text-heading9"
      >
        Welcome to XCIII
      </h1>
      <div
        class="WelcomePage__subtitle"
      >
        A board where the work gets done: cards you move, columns that put an agent on a card when it lands in them, and a terminal for when it is easier to do it yourself.
      </div>
      <div
        class="WelcomePage__content"
      >
        <div
          class="WelcomePage__buttons"
        >
          <button
            class="Button filled size--large"
            type="button"
          >
            
            <span>
              Show me around
            </span>
            <i
              class="CompassIcon icon-chevron-right Icon Icon--right"
            />
          </button>
          <a
            class="skip"
          >
            No thanks, I'll find my way
          </a>
          
        </div>
      </div>
    </div>
  </div>
</div>
`;

