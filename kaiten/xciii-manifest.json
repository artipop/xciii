{
  "name": "kaiten",
  "title": "Kaiten",
  "kind": "mcp",
  "command": "bun",
  "args": ["run", "server.ts"],
  "dir": "ПУТЬ/К/ЭТОМУ/КАТАЛОГУ",
  "tokenEnv": "KAITEN_TOKEN",
  "env": {
    "KAITEN_SITE": "{{.Config.site}}"
  },
  "auth": {"type": "token"},
  "fields": [
    {"key": "site", "title": "Адрес Kaiten", "type": "string", "default": "https://ваш-домен.kaiten.ru"},
    {"key": "boardId", "title": "Доска Kaiten (id)", "type": "number"},
    {"key": "spaceId", "title": "Пространство (id)", "type": "number"},
    {"key": "responsibleOnly", "title": "Только где я ответственный", "type": "bool"}
  ],
  "mcp": {
    "tool": "list_my_cards",
    "arguments": {
      "boardId": "{{.Config.boardId}}",
      "spaceId": "{{.Config.spaceId}}",
      "responsibleOnly": "{{.Config.responsibleOnly}}"
    },
    "itemsAt": "cards",
    "item": {
      "id": "{{.id}}",
      "version": "{{.updated}}",
      "title": "{{.title}}",
      "body": "{{.description}}",
      "url": "{{.url}}",
      "props": {
        "Ссылка": "{{.url}}"
      }
    }
  }
}
