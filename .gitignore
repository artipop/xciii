.task
bin
# The webapp bundle go:embed compiles in — Vite's output, not a source tree.
# The .gitkeep stays tracked so the directory always exists and stays
# embeddable for `go mod tidy`, which checks the pattern under every tag.
**/pack/*
!**/pack/.gitkeep
# `go build .` with no -o leaves a binary named after this directory.
xciii
# The webapp is its own npm project.
node_modules
coverage
.eslintcache
webapp/cypress/videos
webapp/cypress/screenshots
build/linux/appimage/build
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# The macOS icon catalog `common:generate:icons` compiles from appicon.icon,
# and the .icns beside it — `-macassetdir` hands both to the same actool run.
# actool writes a fresh uuid into Assets.car every run, and the CLT/SDK version
# on the machine changes the bytes it writes into icons.icns even from an
# unchanged appicon.icon, so a tracked copy of either is a binary diff after
# every packaging job and nothing in it is worth reviewing. `build` always
# depends on `common:generate:icons`, so both exist fresh by the time the
# darwin package task copies them into the .app — Assets.car optionally, since
# older Icon Composer inputs may not produce one; icons.icns unconditionally.
# Written to match anywhere rather than at the root: the phone module carries
# its own copy of these Taskfiles, generating its own pair from its own icon.
**/build/darwin/Assets.car
**/build/darwin/icons.icns

# The phone app's generated project. `wails3 ios xcode:gen` writes the Xcode
# project and the main.m shim from templates inside the CLI on every build, and
# the Go overlay beside them names absolute paths of this machine.
mobile/build/ios/xcode
mobile/build/android/overlay.json
mobile/build/android/gen
mobile/build/android/app/src/main/jniLibs
# `go build .` in mobile/ leaves a binary named after that directory.
mobile/mobile

# Go workspace files: a local convenience for building this module from a
# git worktree, where the relative replace of the server module does not resolve.
go.work
go.work.sum

# Finder leaves these in every directory it has been asked to draw.
.DS_Store

.idea/
