шнем проекте заметок, вы проверяете и вливаете ветку.", "icon": "🏠", "showDescription": true, "properties": {"acpColumns": [{"propertyId": "achoresstatus00000000000000", "optionId": "achoresagent000000000000000", "property": "Статус", "column": "Агент готовит", "action": "agent"}], "acpFlows": [{"name": "Дело с подготовкой", "property": "Статус", "nodes": [{"id": "agent", "column": "Агент готовит", "optionId": "achoresagent000000000000000"}, {"id": "review", "column": "На проверке", "optionId": "achoresreview00000000000000", "action": "none"}, {"id": "done", "column": "Готово 🙌", "optionId": "achoresdone0000000000000000", "action": "none"}, {"id": "blocked", "column": "Заблокировано", "optionId": "achoresblocked0000000000000", "action": "none"}], "edges": [{"from": "agent", "to": "review", "on": "success"}, {"from": "agent", "to": "blocked", "on": "failure"}, {"from": "review", "to": "done", "on": "branch.merged"}]}, {"name": "Сделать сразу", "property": "Статус", "nodes": [{"id": "agent", "column": "Агент готовит", "optionId": "achoresagent000000000000000"}, {"id": "done", "column": "Готово 🙌", "optionId": "achoresdone0000000000000000", "action": "none"}, {"id": "blocked", "column": "Заблокировано", "optionId": "achoresblocked0000000000000", "action": "none"}], "edges": [{"from": "agent", "to": "done", "on": "success"}, {"from": "agent", "to": "blocked", "on": "failure"}]}], "xciiiTemplate": "home-chores", "acpSetup": {"steps": [{"kind": "project", "hint": "Папка с домашними заметками: агент оставит в ней план и чек-лист."}, {"kind": "agent"}, {"kind": "done"}]}}}, "createAt": 1785888000000, "updateAt": 1785888000000, "deleteAt": 0}}
